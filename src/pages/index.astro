---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { getCollection } from 'astro:content';

// Fetch all recipes
const recipes = await getCollection('recipes');

// Get unique tags from all recipes, sorted by frequency
const tagCounts = new Map<string, number>();
recipes.forEach((recipe) => {
  recipe.data.tags.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});
// All tags used by at least one recipe, most used first
const sortedTags = [...tagCounts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0])
);
const POPULAR_COUNT = 12;
const popularTags = sortedTags.slice(0, POPULAR_COUNT);
const moreTags = sortedTags.slice(POPULAR_COUNT);

// Authors present in the content
const authorCounts = new Map<string, number>();
recipes.forEach((recipe) => {
  const author = recipe.data.author;
  authorCounts.set(author, (authorCounts.get(author) || 0) + 1);
});
const authors = [...authorCounts.entries()].sort((a, b) =>
  a[0].localeCompare(b[0])
);

// Extract ingredient names from recipe body for search
function extractIngredients(body: string): string {
  const ingredients: string[] = [];

  // Split by h2 headings and find ingredient sections (contain bullet points)
  const parts = body.split(/^## /m).filter(Boolean);

  for (const part of parts) {
    const lines = part.trim().split('\n');
    const heading = lines[0].trim().toLowerCase();

    // Skip the steps/instructions section
    if (
      heading === 'steps' ||
      heading === 'instructions' ||
      heading === 'directions' ||
      heading === 'method'
    ) {
      continue;
    }

    // Extract bullet point items (ingredients)
    const bodyText = lines.slice(1).join('\n');
    const bulletItems = bodyText.match(/^-\s+.+$/gm);

    if (bulletItems) {
      for (const item of bulletItems) {
        // Remove the bullet point prefix and backtick-enclosed quantities
        const cleaned = item
          .replace(/^-\s+/, '') // Remove bullet prefix
          .replace(/`[^`]+`\s*/g, '') // Remove quantities like `500g`, `2 tbsp`
          .trim()
          .toLowerCase();

        if (cleaned) {
          ingredients.push(cleaned);
        }
      }
    }
  }

  return ingredients.join(' ');
}
---

<BaseLayout title="Home">
  {/* Hero Section */}
  <section class="bg-gradient-to-b from-ctp-mantle to-ctp-base py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-ctp-text mb-4">
        Welcome to <span class="text-ctp-mauve">The Kyburz Table</span>
      </h1>
      <p class="text-lg text-ctp-subtext1 mb-8 max-w-2xl mx-auto">
        A collection of tried and tested recipes for home cooks. Simple,
        delicious, and made with love.
      </p>

      {/* Search Bar */}
      <div class="max-w-xl mx-auto mb-8">
        <div class="relative">
          <svg
            class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-ctp-overlay0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <input
            type="search"
            id="recipe-search"
            placeholder="Search recipes by name or ingredient..."
            class="w-full pl-12 pr-4 py-3 bg-ctp-surface0 text-ctp-text placeholder-ctp-overlay0 rounded-2xl border border-ctp-surface1 focus:border-ctp-mauve focus:outline-none focus:ring-2 focus:ring-ctp-mauve/30 transition-all text-lg"
          />
        </div>
      </div>

      {/* Filters: author + multi-tag (AND) */}
      <div id="recipe-filters" class="space-y-4">
        {
          authors.length > 1 && (
            <div
              class="flex flex-wrap justify-center items-center gap-2"
              role="group"
              aria-label="Filter by author"
            >
              <span class="text-sm text-ctp-subtext0 mr-1">By:</span>
              {authors.map(([author, count]) => (
                <button
                  type="button"
                  data-author={author}
                  aria-pressed="false"
                  class="author-pill px-3 py-1.5 rounded-full text-sm font-medium transition-all bg-ctp-surface0 text-ctp-subtext1 hover:bg-ctp-surface1 border border-ctp-surface1"
                >
                  {author} <span class="opacity-70">({count})</span>
                </button>
              ))}
            </div>
          )
        }

        <div
          class="flex flex-wrap justify-center gap-2"
          id="tag-filters"
          role="group"
          aria-label="Filter by tags (select multiple)"
        >
          {
            popularTags.map(([tag, count]) => (
              <button
                type="button"
                data-tag={tag}
                aria-pressed="false"
                class="tag-pill px-3 py-1.5 rounded-full text-sm font-medium transition-all bg-ctp-surface0 text-ctp-subtext1 hover:bg-ctp-surface1 border border-ctp-surface1"
              >
                {tag.replace(/-/g, ' ')}{' '}
                <span class="opacity-70">({count})</span>
              </button>
            ))
          }
        </div>

        {
          moreTags.length > 0 && (
            <details id="more-tags" class="group">
              <summary class="cursor-pointer list-none text-sm text-ctp-mauve hover:underline select-none">
                <span class="group-open:hidden">
                  Show all tags (+{moreTags.length})
                </span>
                <span class="hidden group-open:inline">Show fewer tags</span>
              </summary>
              <div class="flex flex-wrap justify-center gap-2 mt-3">
                {moreTags.map(([tag, count]) => (
                  <button
                    type="button"
                    data-tag={tag}
                    aria-pressed="false"
                    class="tag-pill px-3 py-1.5 rounded-full text-sm font-medium transition-all bg-ctp-surface0 text-ctp-subtext1 hover:bg-ctp-surface1 border border-ctp-surface1"
                  >
                    {tag.replace(/-/g, ' ')}{' '}
                    <span class="opacity-70">({count})</span>
                  </button>
                ))}
              </div>
            </details>
          )
        }

        <p class="text-xs text-ctp-overlay1">
          Tip: select several tags to narrow results — recipes must match all of
          them.
        </p>
      </div>
    </div>
  </section>

  {/* Recipe Grid */}
  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-8">
      <h2 class="text-2xl font-bold text-ctp-text">
        <span id="grid-title">All Recipes</span>
        <span
          id="recipe-count"
          class="text-ctp-subtext0 font-normal text-lg ml-2"
        >
          ({recipes.length})
        </span>
      </h2>
      <button
        type="button"
        id="clear-filters"
        class="hidden px-4 py-1.5 rounded-full text-sm font-medium bg-ctp-surface0 text-ctp-red border border-ctp-surface1 hover:bg-ctp-surface1 transition-all"
      >
        Clear filters
      </button>
    </div>

    {/* Recipe Grid */}
    <div
      id="recipe-grid"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
    >
      {
        recipes.map((recipe, index) => (
          <div
            class="recipe-item"
            data-title={recipe.data.title.toLowerCase()}
            data-tags={recipe.data.tags.join(',')}
            data-author={recipe.data.author}
            data-ingredients={extractIngredients(recipe.body)}
          >
            <RecipeCard recipe={recipe} priority={index < 6} />
          </div>
        ))
      }
    </div>

    {/* No Results Message */}
    <div id="no-results" class="hidden text-center py-16">
      <svg
        class="w-16 h-16 mx-auto text-ctp-overlay0 mb-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <h3 class="text-xl font-semibold text-ctp-text mb-2">No recipes found</h3>
      <p class="text-ctp-subtext1">
        Try adjusting your search or filter to find what you're looking for.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .tag-pill.active,
  .author-pill.active {
    @apply bg-ctp-mauve text-ctp-base border-ctp-mauve;
  }
</style>

<script>
  import {
    matchesFilter,
    parseFilterParams,
    serializeFilterParams,
    type FilterState,
  } from '../utils/recipeFilter';

  // Client-side search + multi-tag (AND) + author filter, synced to the URL
  const searchInput = document.getElementById(
    'recipe-search'
  ) as HTMLInputElement | null;
  const filters = document.getElementById('recipe-filters');
  const recipeGrid = document.getElementById('recipe-grid');
  const noResults = document.getElementById('no-results');
  const gridTitle = document.getElementById('grid-title');
  const recipeCount = document.getElementById('recipe-count');
  const clearBtn = document.getElementById('clear-filters');
  const moreTags = document.getElementById(
    'more-tags'
  ) as HTMLDetailsElement | null;

  const state: FilterState = parseFilterParams(window.location.search);

  const titleCase = (s: string) =>
    s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

  function setPillActive(pill: HTMLElement, active: boolean) {
    pill.classList.toggle('active', active);
    pill.setAttribute('aria-pressed', String(active));
  }

  function syncPills() {
    filters
      ?.querySelectorAll<HTMLElement>('.tag-pill')
      .forEach((pill) =>
        setPillActive(pill, state.tags.includes(pill.dataset.tag || ''))
      );
    filters
      ?.querySelectorAll<HTMLElement>('.author-pill')
      .forEach((pill) =>
        setPillActive(
          pill,
          !!state.author &&
            pill.dataset.author?.toLowerCase() === state.author.toLowerCase()
        )
      );
    // Open the extra-tags panel if one of its tags is selected
    if (moreTags && moreTags.querySelector('.tag-pill.active')) {
      moreTags.open = true;
    }
  }

  function updateUrl() {
    const url = window.location.pathname + serializeFilterParams(state);
    window.history.replaceState(null, '', url + window.location.hash);
  }

  function filterRecipes() {
    const items =
      recipeGrid?.querySelectorAll<HTMLElement>('.recipe-item') ?? [];
    let visibleCount = 0;

    items.forEach((item) => {
      const visible = matchesFilter(
        {
          title: item.dataset.title || '',
          ingredients: item.dataset.ingredients || '',
          tags: (item.dataset.tags || '').split(',').filter(Boolean),
          author: item.dataset.author || '',
        },
        state
      );
      item.classList.toggle('hidden', !visible);
      if (visible) visibleCount++;
    });

    if (recipeCount) recipeCount.textContent = `(${visibleCount})`;
    noResults?.classList.toggle('hidden', visibleCount > 0);
    recipeGrid?.classList.toggle('hidden', visibleCount === 0);

    const hasFilters =
      state.tags.length > 0 || !!state.author || state.query.trim() !== '';
    clearBtn?.classList.toggle('hidden', !hasFilters);

    if (gridTitle) {
      const parts: string[] = [];
      if (state.tags.length > 0)
        parts.push(state.tags.map(titleCase).join(' + '));
      if (state.author) parts.push(`by ${state.author}`);
      if (parts.length > 0) {
        gridTitle.textContent = parts.join(' ');
      } else {
        gridTitle.textContent = state.query.trim()
          ? 'Search Results'
          : 'All Recipes';
      }
    }
  }

  function update() {
    syncPills();
    filterRecipes();
    updateUrl();
  }

  searchInput?.addEventListener('input', () => {
    state.query = searchInput.value;
    filterRecipes();
    updateUrl();
  });

  filters?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const tagPill = target.closest<HTMLElement>('.tag-pill');
    const authorPill = target.closest<HTMLElement>('.author-pill');

    if (tagPill?.dataset.tag) {
      const tag = tagPill.dataset.tag;
      state.tags = state.tags.includes(tag)
        ? state.tags.filter((t) => t !== tag)
        : [...state.tags, tag];
      update();
    } else if (authorPill?.dataset.author) {
      const author = authorPill.dataset.author;
      state.author =
        state.author?.toLowerCase() === author.toLowerCase() ? null : author;
      update();
    }
  });

  clearBtn?.addEventListener('click', () => {
    state.tags = [];
    state.author = null;
    state.query = '';
    if (searchInput) searchInput.value = '';
    update();
  });

  // Initial state from the URL (?tags=meal-prep,chicken&author=Jonas&q=...)
  if (searchInput && state.query) searchInput.value = state.query;
  update();
</script>
