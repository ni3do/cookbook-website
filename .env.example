# Database Configuration
# Path to the SQLite database file (relative to project root or absolute path)
DATABASE_PATH=data/cookbook.db

# Required: GitHub PAT used by the claude-runner sidecar to push branches
# and open PRs against ni3do/cookbook-website.
# Fine-grained, scoped to that repo with: contents (R/W), pull-requests (R/W),
# metadata (R).
GITHUB_TOKEN=

# Optional overrides — defaults are usually fine.
# PUBLIC_BASE_URL=https://recipes.siwachter.com
# CLAUDE_MODEL=claude-sonnet-4-6
# GITHUB_REPO=ni3do/cookbook-website
# GIT_AUTHOR_NAME=Cookbook Bot
# GIT_AUTHOR_EMAIL=cookbook-bot@siwachter.com

# DO NOT set ANTHROPIC_API_KEY. The sidecar uses subscription (Pro/Max) OAuth
# persisted in the sidecar-claude volume. Setting the API key here would
# silently override OAuth and bill the API account instead.
